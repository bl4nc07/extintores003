  <style>
    :root {
      --primary: #b91c1c;
      --primary-dark: #991b1b;
      --accent: #f97316;
      --secondary: #1c1917;
      --bg: #fafaf9;
      --card: #ffffff;
      --text: #1c1917;
      --text-muted: #57534e;
      --border: #e7e5e4;
      --shadow: 0 4px 16px rgba(185,28,28,0.07);
      --radius: 16px;
      --safe-bottom: env(safe-area-inset-bottom, 0px);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

    html, body {
      height: 100%;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.45;
      overscroll-behavior: none;
    }

    .app {
      max-width: 480px;
      margin: 0 auto;
      min-height: 100vh;
      background: var(--bg);
      position: relative;
      box-shadow: 0 0 40px rgba(0,0,0,0.08);
    }

    .status-bar {
      height: 26px;
      background: var(--secondary);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 16px;
      font-size: 11px;
      font-weight: 600;
      color: #e7e5e4;
    }
    .status-bar .icons { display: flex; gap: 5px; font-size: 10px; }

    .app-header {
      background: var(--card);
      padding: 11px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .brand {
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--primary);
      text-decoration: none;
      line-height: 1.15;
    }
    .brand span { color: var(--secondary); }
    .brand small {
      display: block;
      font-size: 0.62rem;
      font-weight: 600;
      color: var(--text-muted);
      letter-spacing: 0.4px;
      margin-top: 1px;
    }

    .h-btn {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      background: #fef2f2;
      border: none;
      font-size: 1.1rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .h-btn:active { background: #fecaca; }

    .page { display: none; }
    .page.active { display: block; }

    /* Hero rojo */
    .hero {
      margin: 14px 14px 0;
      background: linear-gradient(145deg, #b91c1c 0%, #dc2626 50%, #f97316 130%);
      border-radius: 20px;
      padding: 22px 18px 20px;
      color: white;
      position: relative;
      overflow: hidden;
    }
    .hero::after {
      content: '🧯';
      position: absolute;
      right: -6px;
      bottom: -14px;
      font-size: 5rem;
      opacity: 0.15;
    }
    .hero-tag {
      display: inline-block;
      background: rgba(255,255,255,0.2);
      font-size: 0.68rem;
      font-weight: 700;
      padding: 4px 11px;
      border-radius: 20px;
      margin-bottom: 10px;
    }
    .hero h1 {
      font-size: 1.3rem;
      font-weight: 800;
      line-height: 1.25;
      margin-bottom: 8px;
    }
    .hero p {
      font-size: 0.87rem;
      opacity: 0.92;
      margin-bottom: 16px;
      max-width: 90%;
    }
    .hero-btns { display: flex; gap: 9px; flex-wrap: wrap; }
    .btn-h {
      background: white;
      color: var(--primary);
      border: none;
      padding: 11px 18px;
      border-radius: 50px;
      font-weight: 700;
      font-size: 0.84rem;
      text-decoration: none;
      display: inline-block;
    }
    .btn-h.ghost {
      background: transparent;
      color: white;
      border: 1.5px solid rgba(255,255,255,0.5);
    }

    /* Dirección destacada */
    .addr-bar {
      margin: 12px 14px 0;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      gap: 12px;
      box-shadow: var(--shadow);
